         * @return string 'live' or 'test'.
         */
        protected function get_stripe_mode(): string
        {
        }
        /**
         * Destination after a successful OAuth handshake: back to the checklist page.
         *
         * @since 2.0.0
         *
         * @return string
         */
        protected function get_destination_url(): string
        {
        }
    }
