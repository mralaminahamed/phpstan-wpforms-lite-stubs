        /**
         * Inform clients that the class is removed.
         *
         * @since 1.8.0
         */
        public function __construct()
        {
        }
        /**
         * Inform clients that the class is removed.
         *
         * @since 1.8.0
         *
         * @param string $name Property name.
         */
        public function __get($name)
        {
        }
        /**
         * Inform clients that the class is removed.
         *
         * @since 1.8.0
         *
         * @param string $name  Property name.
